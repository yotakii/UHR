# إعدادات السيرفر — يُنشئ deploy.sh ملف deploy/.env من هذا الملف أول مرة (مع مفتاح وكلمة سر عشوائيين)
# لا يُرفع .env إلى GitHub أبداً

# staging = سيرفر التجربة (يسمح ببيانات الديمو TestDataSeeder) · production = التشغيل الحقيقي
APP_NAME=UHR
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://atmata-uhr.duckdns.org
FRONTEND_URL=https://atmata-uhr.duckdns.org
APP_TIMEZONE=Asia/Damascus
APP_LOCALE=ar

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=uhr
DB_USERNAME=uhr
DB_PASSWORD=

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PORT=6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=480
SESSION_SECURE_COOKIE=true
FILESYSTEM_DISK=local

# البريد: mailpit يلتقط كل الرسائل على سيرفر التجربة. للتشغيل الحقيقي ضع بيانات SMTP الشركة
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM_ADDRESS=no-reply@atmata-group.com
MAIL_FROM_NAME=UHR

# التحديث اللحظي (Reverb) — deploy.sh يملأ المفتاح والسر عشوائياً إن غابا
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=uhr
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# بورت الواجهة على السيرفر (يوجّه له Nginx Proxy Manager) وبورت صندوق البريد (محلي فقط)
UHR_HTTP_PORT=8190
UHR_MAIL_PORT=8126

# الفرع الذي يُنشر من GitHub
DEPLOY_BRANCH=release
